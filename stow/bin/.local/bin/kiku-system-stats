#!/usr/bin/env bash
# kiku-system-stats: Output basic cpu/thermal stats in key\tvalue format

set -euo pipefail

# CPU Temperature
temp=""
for t in /sys/class/thermal/thermal_zone*/temp; do
  if [ -r "$t" ]; then
    raw=$(cat "$t" 2>/dev/null || echo 0)
    if [ "$raw" -gt 0 ]; then
      temp=$(( raw / 1000 ))
      break
    fi
  fi
done

[ -n "$temp" ] && echo -e "temp\t${temp}°C"
