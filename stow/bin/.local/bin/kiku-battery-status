#!/bin/bash

# omarchy:summary=Returns a formatted battery status string with percentage and power draw/charge.
# omarchy:args=[--shell]

shell_output=false
power_supply_path="${OMARCHY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

case "${1:-}" in
  "")
    ;;
  --shell)
    shell_output=true
    ;;
  *)
    echo "Usage: kiku-battery-status [--shell]" >&2
    exit 2
    ;;
esac

battery=$(upower -e 2>/dev/null | grep BAT | head -n 1)
[[ -z $battery ]] && exit 0

battery_info=$(upower -i "$battery")

percentage=$(awk '/percentage/ { print int($2); exit }' <<<"$battery_info")
native_path=$(awk '/native-path/ { print $2; exit }' <<<"$battery_info")
battery_path="$power_supply_path/$native_path"

state=$(awk '/state/ { print $2; exit }' <<<"$battery_info")
threshold_start=$(awk '/charge-start-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")
threshold_end=$(awk '/charge-end-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")

[[ -z $threshold_end ]] && threshold_end=$(cat "$power_supply_path"/BAT*/charge_control_end_threshold 2>/dev/null | head -1)
[[ -z $threshold_start ]] && threshold_start=$(cat "$power_supply_path"/BAT*/charge_control_start_threshold 2>/dev/null | head -1)

# Instantaneous power draw/rate
power_rate_raw=""
if [[ -r $battery_path/power_now ]]; then
  power_rate_raw=$(awk -v microwatts="$(<"$battery_path/power_now")" 'BEGIN { print microwatts / 1000000 }')
elif [[ -r $battery_path/current_now && -r $battery_path/voltage_now ]]; then
  power_rate_raw=$(awk \
    -v microamps="$(<"$battery_path/current_now")" \
    -v microvolts="$(<"$battery_path/voltage_now")" \
    'BEGIN { print microamps * microvolts / 1000000000000 }')
fi
[[ -z $power_rate_raw ]] && power_rate_raw=$(awk '/energy-rate/ { print $2; exit }' <<<"$battery_info")

power_rate=$(awk -v rate="${power_rate_raw:-0}" 'BEGIN {
  rounded = sprintf("%.1f", rate)
  sub(/\.0$/, "", rounded)
  print rounded
}')

# Battery design capacity (size)
capacity_raw=""
if [[ -r $battery_path/energy_full_design ]]; then
  capacity_raw=$(awk -v uwh="$(<"$battery_path/energy_full_design")" 'BEGIN { print uwh / 1000000 }')
elif [[ -r $battery_path/charge_full_design && -r $battery_path/voltage_min_design ]]; then
  capacity_raw=$(awk -v uah="$(<"$battery_path/charge_full_design")" -v uv="$(<"$battery_path/voltage_min_design")" 'BEGIN { print uah * uv / 1000000000000 }')
fi
[[ -z $capacity_raw ]] && capacity_raw=$(awk '/energy-full-design:/ { print $2; exit }' <<<"$battery_info")
[[ -z $capacity_raw ]] && capacity_raw=$(awk '/energy-full:/ { print $2; exit }' <<<"$battery_info")

capacity=$(awk -v cap="${capacity_raw:-0}" 'BEGIN {
  rounded = sprintf("%.1f", cap)
  sub(/\.0$/, "", rounded)
  print rounded
}')

# Live energy telemetry for dynamic time estimation
energy_now_raw=""
if [[ -r $battery_path/energy_now ]]; then
  energy_now_raw=$(awk -v uwh="$(<"$battery_path/energy_now")" 'BEGIN { print uwh / 1000000 }')
elif [[ -r $battery_path/charge_now && -r $battery_path/voltage_now ]]; then
  energy_now_raw=$(awk -v uah="$(<"$battery_path/charge_now")" -v uv="$(<"$battery_path/voltage_now")" 'BEGIN { print uah * uv / 1000000000000 }')
fi
[[ -z $energy_now_raw ]] && energy_now_raw=$(awk '/energy:/ { print $2; exit }' <<<"$battery_info")

energy_full_raw=""
if [[ -r $battery_path/energy_full ]]; then
  energy_full_raw=$(awk -v uwh="$(<"$battery_path/energy_full")" 'BEGIN { print uwh / 1000000 }')
elif [[ -r $battery_path/charge_full && -r $battery_path/voltage_now ]]; then
  energy_full_raw=$(awk -v uah="$(<"$battery_path/charge_full")" -v uv="$(<"$battery_path/voltage_now")" 'BEGIN { print uah * uv / 1000000000000 }')
fi
[[ -z $energy_full_raw ]] && energy_full_raw=$(awk '/energy-full:/ { print $2; exit }' <<<"$battery_info")

time_remaining=""
if awk -v rate="${power_rate_raw:-0}" -v enow="${energy_now_raw:-0}" 'BEGIN { exit !(rate > 0.1 && enow > 0) }'; then
  time_remaining=$(awk \
    -v state="$state" \
    -v rate="$power_rate_raw" \
    -v enow="$energy_now_raw" \
    -v efull="$energy_full_raw" \
    -v tend="${threshold_end:-0}" 'BEGIN {
      hours = -1
      if (state == "discharging") {
        hours = enow / rate
      } else if (state == "charging") {
        target = efull
        if (tend > 0 && tend < 99) {
          target = efull * (tend / 100.0)
        }
        if (target > enow) {
          hours = (target - enow) / rate
        }
      }
      if (hours > 0) {
        tot_mins = int(hours * 60 + 0.5)
        h = int(tot_mins / 60)
        m = tot_mins % 60
        if (h > 0 && m > 0) {
          printf "%dh %dm", h, m
        } else if (h > 0) {
          printf "%dh", h
        } else if (m > 0) {
          printf "%dm", m
        } else {
          printf "< 1m"
        }
      }
    }')
fi

if [[ -z $time_remaining ]]; then
  time_remaining=$(awk '/time to (empty|full)/ {
    value = $4
    unit = $5
    if (unit ~ /^minute/) {
      printf "%dm", int(value + 0.5)
    } else {
      tot_mins = int(value * 60 + 0.5)
      h = int(tot_mins / 60)
      m = tot_mins % 60
      if (h > 0 && m > 0) {
        printf "%dh %dm", h, m
      } else if (h > 0) {
        printf "%dh", h
      } else {
        printf "%dm", m
      }
    }
    exit
  }' <<<"$battery_info")
fi

ac_online=false
for supply in "$power_supply_path"/*; do
  [[ -r $supply/type ]] || continue
  [[ $(<"$supply/type") == "Mains" ]] || continue
  [[ -r $supply/online ]] || continue

  if [[ $(<"$supply/online") == "1" ]]; then
    ac_online=true
    break
  fi
done

charge_idle=false
if awk -v rate="${power_rate_raw:-0}" 'BEGIN { exit !(rate <= 0.2) }'; then
  charge_idle=true
fi

charge_holding=false
if [[ $ac_online == "true" && -n $threshold_end ]]; then
  if [[ $state == "pending-charge" ]]; then
    charge_holding=true
  elif [[ $state == "fully-charged" ]] && (( percentage < 99 )); then
    charge_holding=true
  elif [[ $state == "charging" && $charge_idle == "true" ]] && (( threshold_end < 99 && percentage >= threshold_end )); then
    charge_holding=true
  fi
fi

if [[ $shell_output == "true" ]]; then
  printf 'percentage\t%s\n' "${percentage}%"
  if [[ $charge_holding == "true" ]]; then
    printf 'state\tholding\n'
  else
    printf 'state\t%s\n' "$state"
  fi
  printf 'rate\t%s\n' "${power_rate}W"
  printf 'size\t%s\n' "${capacity}Wh"
  printf 'time\t%s\n' "$time_remaining"

  cycles=$(cat "$power_supply_path"/BAT*/cycle_count 2>/dev/null | head -1)

  [[ -n $cycles ]] && printf 'cycles\t%s\n' "$cycles"

  if [[ -n $threshold_end ]]; then
    if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
      printf 'threshold\t%s-%s%%\n' "$threshold_start" "$threshold_end"
    else
      printf 'threshold\t%s%%\n' "$threshold_end"
    fi
  fi

  exit 0
fi

if [[ $charge_holding == "true" ]]; then
  if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
    threshold_label="${threshold_start}-${threshold_end}%"
  else
    threshold_label="${threshold_end}%"
  fi

  echo "Battery ${percentage}%  ·  Holding at ${threshold_label}  ·  ${power_rate}W / ${capacity}Wh"
elif [[ $state == "charging" ]]; then
  echo "Battery ${percentage}%  ·  ${time_remaining} to full  ·   ${power_rate}W / ${capacity}Wh"
else
  echo "Battery ${percentage}%  ·  ${time_remaining} left  ·   ${power_rate}W / ${capacity}Wh"
fi
