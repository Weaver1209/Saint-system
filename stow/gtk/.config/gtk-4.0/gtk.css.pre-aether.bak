/* Catppuccin Mocha GTK 4 / Libadwaita Theme */

@define-color accent_color #cba6f7;
@define-color accent_bg_color #cba6f7;
@define-color accent_fg_color #11111b;

@define-color destructive_color #f38ba8;
@define-color destructive_bg_color #f38ba8;
@define-color destructive_fg_color #11111b;

@define-color success_color #a6e3a1;
@define-color success_bg_color #a6e3a1;
@define-color success_fg_color #11111b;

@define-color warning_color #f9e2af;
@define-color warning_bg_color #f9e2af;
@define-color warning_fg_color #11111b;

@define-color error_color #f38ba8;
@define-color error_bg_color #f38ba8;
@define-color error_fg_color #11111b;

@define-color window_bg_color #1e1e2e;
@define-color window_fg_color #cdd6f4;

@define-color view_bg_color #1e1e2e;
@define-color view_fg_color #cdd6f4;

@define-color headerbar_bg_color #181825;
@define-color headerbar_fg_color #cdd6f4;
@define-color headerbar_border_color #11111b;
@define-color headerbar_backdrop_color #181825;

@define-color sidebar_bg_color #181825;
@define-color sidebar_fg_color #cdd6f4;
@define-color sidebar_backdrop_color #181825;

@define-color secondary_sidebar_bg_color #181825;
@define-color secondary_sidebar_fg_color #cdd6f4;
@define-color secondary_sidebar_backdrop_color #181825;

@define-color card_bg_color #181825;
@define-color card_fg_color #cdd6f4;

@define-color dialog_bg_color #1e1e2e;
@define-color dialog_fg_color #cdd6f4;

@define-color popover_bg_color #181825;
@define-color popover_fg_color #cdd6f4;

@define-color shade_color rgba(0, 0, 0, 0.36);
@define-color scrollbar_outline_color rgba(0, 0, 0, 0.5);

/* Window & General Background */
window, .background, .view, view, viewport, stack, .content-view, scrolledwindow {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

headerbar {
    background-color: #181825;
    color: #cdd6f4;
    border-bottom: 1px solid #11111b;
}

/* Sidebar Styling */
.sidebar, stacksidebar, navigation-sidebar, placesview {
    background-color: #181825;
    color: #cdd6f4;
}

.sidebar row, navigation-sidebar row, placesview row {
    border-radius: 6px;
    padding: 6px 8px;
    color: #cdd6f4;
}

.sidebar row:hover, navigation-sidebar row:hover, placesview row:hover {
    background-color: #313244;
    color: #cdd6f4;
}

.sidebar row:selected, navigation-sidebar row:selected, placesview row:selected {
    background-color: #45475a;
    color: #cba6f7;
    font-weight: bold;
}

/* File Chooser, Lists & Column Views */
filechooser, GtkFileChooserWidget, columnview, listview, gridview, treeview {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

columnview row, listview row, treeview.view {
    color: #cdd6f4;
}

columnview row:hover, listview row:hover, treeview.view:hover {
    background-color: #313244;
}

columnview row:selected, listview row:selected, gridview child:selected, treeview.view:selected {
    background-color: #45475a;
    color: #cba6f7;
}

/* Path Bar / Breadcrumbs in GTK4 File Picker */
.path-bar button, filechooser .path-bar button {
    background-color: transparent;
    color: #cdd6f4;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
}

.path-bar button:hover, filechooser .path-bar button:hover {
    background-color: #313244;
    color: #cba6f7;
}

.path-bar button:checked, .path-bar button:active, filechooser .path-bar button:checked {
    background-color: #45475a;
    color: #cba6f7;
    font-weight: bold;
}

/* Entries and Search Bars */
entry, searchbar {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 8px;
}

entry:focus-within, searchbar:focus-within {
    border-color: #cba6f7;
}

/* Buttons */
button {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 8px;
}

button:hover {
    background-color: #45475a;
    color: #cdd6f4;
}

button:active, button:checked {
    background-color: #585b70;
    color: #cba6f7;
}

button.suggested-action {
    background-color: #cba6f7;
    color: #11111b;
    border: none;
    font-weight: bold;
}

button.suggested-action:hover {
    background-color: #b4befe;
    color: #11111b;
}

button.destructive-action {
    background-color: #f38ba8;
    color: #11111b;
    border: none;
    font-weight: bold;
}

button.destructive-action:hover {
    background-color: #eba0ac;
    color: #11111b;
}

button.flat {
    background-color: transparent;
    border-color: transparent;
}

button.flat:hover {
    background-color: #313244;
}

/* Popovers & Context Menus — flat, no box */
popover, popover.menu, popover.background {
    background: none;
    background-color: #313244;
    color: #cdd6f4;
    border: none;
    border-radius: 6px;
    box-shadow: none;
    outline: none;
    padding: 4px 0;
    margin: 0;
    min-width: 0;
    min-height: 0;
}

popover > contents, popover.menu > contents {
    background: none;
    background-color: transparent;
    color: inherit;
    padding: 0;
    margin: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
    outline: none;
    min-width: 0;
}

popover > arrow, popover.menu > arrow {
    background: none;
    border: none;
    box-shadow: none;
    min-width: 0;
    min-height: 0;
}

popover scrolledwindow, popover viewport, popover stack,
popover box, popover grid {
    background-color: transparent;
    padding: 0;
    margin: 0;
    border: none;
    min-width: 0;
}

popover modelbutton, popover.menu modelbutton {
    min-height: 26px;
    min-width: 0;
    padding: 4px 8px;
    margin: 0;
    border-radius: 0;
    color: #cdd6f4;
    background: transparent;
    border: none;
}

popover modelbutton:hover, popover.menu modelbutton:hover {
    background-color: #45475a;
    color: #cdd6f4;
}

popover modelbutton accelerator, popover.menu modelbutton accelerator {
    color: #a6adc8;
    padding: 0 0 0 12px;
}

popover separator, popover.menu separator {
    margin: 2px 0;
    background-color: #45475a;
    min-height: 1px;
}

/* Scrollbars */
scrollbar slider {
    background-color: #45475a;
    border-radius: 4px;
    min-width: 6px;
    min-height: 6px;
}

scrollbar slider:hover {
    background-color: #585b70;
}

scrollbar slider:active {
    background-color: #cba6f7;
}
