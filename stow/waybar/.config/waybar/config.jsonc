{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 34,
  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "custom/dns",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "battery"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "󰄯",
      "active": "󱓻"
    }
  },
  "custom/launcher": {
    "format": "󰍜",
    "on-click": "rofi -show drun",
    "tooltip-format": "App Launcher"
  },
  "cpu": {
    "interval": 5,
    "format": "󰍛",
    "on-click": "alacritty --class omarchy-tui-cpu -e sh -c 'command -v btop >/dev/null && btop || htop'"
  },
  "clock": {
    "format": "{:L%A %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip": false
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "interval": 3,
    "on-click": "alacritty --class omarchy-tui-net -e $HOME/.cargo/bin/impala"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "interval": 5,
    "on-click": "wlogout"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "on-click": "alacritty --class omarchy-tui-bt -e $HOME/.cargo/bin/bluetui"
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "alacritty --class omarchy-tui-audio -e sh -c 'command -v wiremix >/dev/null && wiremix || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 17
  },
  "custom/dns": {
    "exec": "$HOME/.config/hypr/scripts/dns-toggle.sh status",
    "interval": 5,
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "on": "󰒄",
      "off": "󰦞"
    },
    "on-click": "$HOME/.config/hypr/scripts/dns-toggle.sh toggle",
    "exec-on-event": true
  }
}
